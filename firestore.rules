rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'muhammad.ahsan41205@guru.smp.belajar.id' ||
        request.auth.token.email == 'admin@darulfaqih.sch.id' ||
        request.auth.uid == 'admin_darulfaqih' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. Users collection: Setiap user HANYA bisa membaca dan menulis dokumen profilnya sendiri
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && (incoming().uid == existing().uid);
      allow delete: if isOwner(userId) || isAdmin();

      // Sub-koleksi progress per user: Hanya pemilik akun yang dapat membaca & memperbarui
      match /progress/{progressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Quiz results collection: Setiap user HANYA bisa membuat, membaca, dan mengelola hasil kuis miliknya
    match /quizResults/{resultId} {
      // User hanya dapat melihat dan me-list kuis miliknya sendiri (resource.data.userId == request.auth.uid)
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // User hanya dapat menyimpan hasil kuis dengan userId miliknya sendiri
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 3. Pengumuman Madrasah
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Daftar Admin
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
